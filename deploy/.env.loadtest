# ============================================================
# 压测环境变量（仅供 deploy/docker-compose.loadtest.yml 使用）
#
# 用法：
#   docker compose --env-file deploy/.env.loadtest -f deploy/docker-compose.loadtest.yml up -d
#
# 注意：LT_MYSQL_USER / LT_MYSQL_PASSWORD / LT_REDIS_PASSWORD 三个值
#       必须与 application-loadtest.yml 中的默认值保持一致，
#       否则「用法 A（应用跑宿主机）」会连不上数据库 / Redis。
#       当前默认值：blog_lt / loadtest-db-pwd / loadtest-redis-pwd
#
# 本文件是压测专用的一次性凭据，与生产 .env 无关，请勿复用生产密钥。
# ============================================================

LT_MYSQL_ROOT_PASSWORD=loadtest-root-pwd
LT_MYSQL_USER=blog_lt
LT_MYSQL_PASSWORD=loadtest-db-pwd

LT_REDIS_PASSWORD=loadtest-redis-pwd

LT_JWT_SECRET=loadtest-only-jwt-secret-not-for-production-use-please-change

# 此为.env文件模板，请在部署时替换为真实的MySQL等密钥，且禁止上传至仓库！

# variables for dev environment
DB_USERNAME_DEV=change-me-to-your-own-username
DB_PASSWORD_DEV=change-me-to-strong-password
JWT_SECRET=change-me-to-strong-secret-with-more-than-32-characters

# variables for prod environment
DB_USERNAME_PROD=blog_app
DB_PASSWORD_PROD=change-me-to-password-stronger-than-developing-environment
JWT_SECRET_PROD=change-me-to-strong-secret-with-more-than-32-characters

# variables for SMTP mail service (忘记密码验证码；未配置时发送验证码接口会返回 500)
# —— 真实投递：QQ 邮箱（465 隐式 SSL）——
#   授权码获取：QQ 邮箱 → 设置 → 账户 → POP3/SMTP/IMAP → 开启 SMTP → 生成 16 位授权码
#   关键：SMTP_PASSWORD 填授权码（非登录密码）；SMTP_FROM 必须与 SMTP_USERNAME 一致
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USERNAME=你的QQ号@qq.com
SMTP_PASSWORD=在此填入QQ邮箱生成的16位授权码
SMTP_FROM=你的QQ号@qq.com
SMTP_SSL_ENABLE=true
SMTP_STARTTLS_ENABLE=false
# —— 其他服务商参考：——
#   163  : host=smtp.163.com,   port=465, SMTP_SSL_ENABLE=true，密码填客户端授权密码
#   Gmail: host=smtp.gmail.com, port=587, SMTP_STARTTLS_ENABLE=true，密码填应用专用密码
# —— 仅本地联调不想发真实邮件时，改用 MailHog（docker compose 自带，Web 收件箱 http://localhost:8025）——
#   SMTP_HOST=mailhog  SMTP_PORT=1025  SMTP_USERNAME=  SMTP_PASSWORD=
#   SMTP_FROM=noreply@blog.local  SMTP_SSL_ENABLE=false  SMTP_STARTTLS_ENABLE=false